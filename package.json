{
  "name": "consensus-terminal",
  "version": "1.1.0",
  "description": "共识终端机：让会议决策真正生效。会前准备 → 记录共识与分歧 → 扫码匿名打分 → 导出行动点",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"node --watch server.js\" \"vite\"",
    "build": "vite build",
    "start": "node server.js",
    "test": "vitest run"
  },
  "keywords": ["consensus", "meeting", "decision", "voting", "vue", "express"],
  "engines": { "node": ">=18" },
  "dependencies": {
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "supertest": "^7.0.0",
    "vite": "^6.0.7",
    "vitest": "^3.0.4"
  }
}
